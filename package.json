{
  "name": "pixelguard",
  "version": "0.1.0",
  "description": "AI-powered visual regression testing agent",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixelguard": "./dist/cli.js"
  },
  "scripts": {
    "pixelguard": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests scripts examples public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:diff": "tsx scripts/generate-diff-fixtures.ts",
    "demo": "tsx scripts/demo.ts",
    "dev:dashboard": "tsx src/cli.ts dashboard",
    "start": "node dist/cli.js dashboard"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.45.0",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.4",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
