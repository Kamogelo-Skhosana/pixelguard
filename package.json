{
  "name": "pixelguard",
  "version": "0.1.0",
  "description": "AI-powered visual regression testing agent",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixelguard": "./dist/cli.js"
  },
  "scripts": {
    "pixelguard": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:dashboard": "tsx src/dashboard/server.ts"
  },
  "dependencies": {
    "playwright": "^1.45.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^11.1.2",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "eslint": "^9.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.4"
  }
}
