# Target application (TARGET_BASE_URL is required)
TARGET_BASE_URL=https://example-target.com
TARGET_PAGES=/,/search,/checkout

# Optional: override the default viewports (desktop 1440x900, tablet 768x1024, mobile 390x844)
# Format: name:WIDTHxHEIGHT, comma-separated
# VIEWPORTS=desktop:1440x900,tablet:768x1024,mobile:390x844

# Optional: use a specific Chromium/Chrome binary instead of Playwright's bundled one
# PIXELGUARD_CHROMIUM_PATH=

# Where screenshots are stored (screenshots/<tag>/<viewport>/<page>.png)
OUTPUT_DIR=screenshots

# Known dynamic regions (timestamps, ads, carousels...) to ignore or flag as expected.
# Defaults to pixelguard.regions.json if it exists — see pixelguard.regions.example.json
# REGIONS_FILE=pixelguard.regions.json

# Where diff images are written (diffs/<baseline>-vs-<current>/<viewport>/<page>.png)
DIFF_DIR=diffs

# LLM provider for the judgment layer (Phase 2, vision-capable)
# Not needed for Phase 1 capture/diff
LLM_API_KEY=your-llm-api-key
LLM_MODEL=claude-sonnet-5

# Storage
# "sqlite:" prefix is optional — it is stripped before opening the file
DATABASE_URL=sqlite:./pixelguard.db

# Dashboard (Phase 3) — run with: npm run pixelguard -- dashboard
# 127.0.0.1 = only this computer can open it; use 0.0.0.0 inside Docker or to share on your network
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8100
# true = view runs and history only; accepting/restoring baselines is turned off
# (use this when sharing the dashboard; see docs/DEPLOYMENT.md)
DASHBOARD_READ_ONLY=false
