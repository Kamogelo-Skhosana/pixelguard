# Target application (TARGET_BASE_URL is required)
TARGET_BASE_URL=https://example-target.com
TARGET_PAGES=/,/search,/checkout

# Optional: override the default viewports (desktop 1440x900, tablet 768x1024, mobile 390x844)
# Format: name:WIDTHxHEIGHT, comma-separated
# VIEWPORTS=desktop:1440x900,tablet:768x1024,mobile:390x844

# Optional: use a specific Chromium/Chrome binary instead of Playwright's bundled one
# PIXELGUARD_CHROMIUM_PATH=

# Where screenshots are stored (screenshots/<tag>/<viewport>/<page>.png)
OUTPUT_DIR=screenshots

# LLM provider for the judgment layer (Phase 2, vision-capable)
# Not needed for Phase 1 capture/diff
LLM_API_KEY=your-llm-api-key
LLM_MODEL=claude-sonnet-4-6

# Storage
# "sqlite:" prefix is optional — it is stripped before opening the file
DATABASE_URL=sqlite:./pixelguard.db

# Dashboard (Phase 3)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8100
